#!/usr/bin/env sh
# Warn when pushing to any branch other than test.
# Team flow: local -> test -> develop -> master

warned=0

while read local_ref local_sha remote_ref remote_sha
do
  case "$remote_ref" in
    refs/heads/*)
      remote_branch=${remote_ref#refs/heads/}
      ;;
    *)
      continue
      ;;
  esac

  if [ "$remote_branch" != "test" ]; then
    warned=1
    echo ""
    echo "[pre-push warning] You are pushing to '$remote_branch'."
    echo "Expected promotion flow is: local -> test -> develop -> master."
    echo "If this is intentional, continue."
    echo ""
  fi
done

exit 0
